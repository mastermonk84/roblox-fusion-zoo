#!/bin/sh
# Lint staged Luau files. Enable once per clone: git config core.hooksPath .githooks
export PATH="$HOME/.rokit/bin:$PATH"
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(luau|lua)$')
[ -z "$files" ] && exit 0
echo "$files" | tr '\n' '\0' | xargs -0 selene || exit 1
echo "$files" | tr '\n' '\0' | xargs -0 stylua --check || { echo "Run: stylua <files> to format"; exit 1; }
