--!strict
-- data-src/*.json -> src/shared/Data/*.luau (strict table literals, DO NOT EDIT
-- headers) with full content validation (acceptance criterion 2). Run on every
-- data change: lune run scripts/build-data

local fs = require("@lune/fs")
local serde = require("@lune/serde")
local process = require("@lune/process")

local function readJson(path: string): any
	return serde.decode("json", fs.readFile(path))
end

local errors: { string } = {}
local function check(cond: boolean, message: string)
	if not cond then
		table.insert(errors, message)
	end
end

-- ── Luau literal serializer (stable key order, strings escaped) ─────────────
local function isIdent(s: string): boolean
	return string.match(s, "^[%a_][%w_]*$") ~= nil
end

local function serialize(value: any, indent: number): string
	local t = type(value)
	if t == "string" then
		return string.format("%q", value)
	elseif t == "number" or t == "boolean" then
		return tostring(value)
	elseif t == "table" then
		local tab = value :: { [any]: any }
		local pad = string.rep("\t", indent + 1)
		local parts: { string } = {}
		if #tab > 0 then
			for _, v in ipairs(tab) do
				table.insert(parts, pad .. serialize(v, indent + 1) .. ",")
			end
		else
			local keys: { string } = {}
			for k in tab do
				assert(type(k) == "string", "non-string map key")
				table.insert(keys, k)
			end
			table.sort(keys)
			for _, k in keys do
				local keyRepr = if isIdent(k) then k else `[{string.format("%q", k)}]`
				table.insert(parts, `{pad}{keyRepr} = {serialize(tab[k], indent + 1)},`)
			end
		end
		if #parts == 0 then
			return "{}"
		end
		return "{\n" .. table.concat(parts, "\n") .. "\n" .. string.rep("\t", indent) .. "}"
	end
	error(`cannot serialize {t}`)
end

local function emit(name: string, value: any)
	local body = "--!strict\n-- GENERATED by scripts/build-data — DO NOT EDIT.\n"
		.. "-- Source of truth: data-src/. Edit there and rerun the script.\n\n"
		.. "return "
		.. serialize(value, 0)
		.. "\n"
	fs.writeFile(`src/shared/Data/{name}.luau`, body)
end

-- ── Curriculum ──────────────────────────────────────────────────────────────
type Item = {
	text: string,
	components: { string },
	pinyin: string,
	english: string,
	band: number,
	seq: number,
	source: string,
	category: string,
	needs_visual: boolean,
	grammar: boolean,
	value: number?,
	confidence: string,
	bonus: boolean?,
}
local curriculum = readJson("data-src/curriculum_grade1.json") :: { Item }

local coreCount = 0
for _, item in curriculum do
	if not item.bonus then
		coreCount += 1
	end
end
check(coreCount == 700, `curriculum must have exactly 700 non-bonus items, has {coreCount}`)
local textSeen: { [string]: boolean } = {}
local bandCounts: { [number]: number } = {}
local pinyinIndex: { [string]: { string } } = {}
for i, item in curriculum do
	check(textSeen[item.text] ~= true, `duplicate item text {item.text}`)
	textSeen[item.text] = true
	check(type(item.pinyin) == "string" and #item.pinyin > 0, `{item.text}: missing pinyin`)
	check(type(item.english) == "string" and #item.english > 0, `{item.text}: missing english`)
	check(item.band >= 1 and item.band <= 14, `{item.text}: band {item.band} out of range`)
	check(item.seq == i, `{item.text}: seq {item.seq} != position {i}`)
	check(item.band >= 1 and item.band <= 14, `{item.text}: band out of range`)
	check(#item.components >= 1, `{item.text}: empty components`)
	check(table.concat(item.components) == item.text, `{item.text}: components don't spell text`)
	if item.grammar then
		check(not item.needs_visual, `{item.text}: grammar word cannot be needs_visual`)
	end
	if item.value ~= nil then
		check(item.category == "number", `{item.text}: value on non-number category`)
	end
	if not item.bonus then
		bandCounts[item.band] = (bandCounts[item.band] or 0) + 1
	end
	local list = pinyinIndex[item.pinyin]
	if not list then
		list = {}
		pinyinIndex[item.pinyin] = list
	end
	table.insert(list, item.text)
end
for band = 1, 14 do
	check(bandCounts[band] == 50, `band {band} has {bandCounts[band] or 0} items, want 50`)
end
-- Homophone rule feasibility: every non-grammar item must have >= 2 candidate
-- distractors with a different exact pinyin (trivially true at this scale; prove it).
for _, item in curriculum do
	if not item.grammar then
		local sameCount = #pinyinIndex[item.pinyin]
		check(#curriculum - sameCount >= 2, `{item.text}: not enough distinct-pinyin distractors`)
	end
end

-- ── Animals ─────────────────────────────────────────────────────────────────
type Animal = {
	char: string,
	pinyin: string,
	english: string,
	li: number,
	su: number,
	zhi: number,
	tier: number,
	rig: string,
}
local animals = readJson("data-src/animals.json") :: { Animal }
check(#animals == 18, `expected 18 launch animals, got {#animals}`)
local animalChars: { [string]: boolean } = {}
for _, a in animals do
	check(animalChars[a.char] ~= true, `duplicate animal {a.char}`)
	animalChars[a.char] = true
	check(textSeen[a.char] == true, `animal {a.char} not in curriculum`)
	check(a.tier >= 1 and a.tier <= 5, `animal {a.char}: tier {a.tier} out of range`)
	for _, stat in { a.li, a.su, a.zhi } do
		check(stat >= 1 and stat <= 5, `animal {a.char}: innate stat {stat} out of 1..5`)
	end
end

-- ── Opponents ───────────────────────────────────────────────────────────────
type Opponent = { name: string, pinyin: string, li: number, su: number, zhi: number }
local opponents = readJson("data-src/opponents.json") :: { Opponent }
check(#opponents == 12, `expected 12 NPC rungs, got {#opponents}`)
local oppSeen: { [string]: boolean } = {}
for _, o in opponents do
	check(oppSeen[o.name] ~= true, `duplicate opponent {o.name}`)
	oppSeen[o.name] = true
end

-- ── Words (real-word fusion combos) ─────────────────────────────────────────
type Word = { word: string, pinyin: string, english: string, pair: { string } }
local words = readJson("data-src/words.json") :: { Word }
for _, w in words do
	check(#w.pair == 2, `word {w.word}: pair must have 2 chars`)
	for _, c in w.pair do
		check(animalChars[c] == true, `word {w.word}: {c} is not an animal`)
	end
	check(w.pair[1] .. w.pair[2] == w.word, `word {w.word}: pair doesn't spell word`)
end

-- ── Foods / decorations / colorways / cheers ────────────────────────────────
local foods = readJson("data-src/foods.json")
local decorations = readJson("data-src/decorations.json") :: { { id: string, cost: number } }
for _, d in decorations do
	check(d.cost >= 2 and d.cost <= 5, `decoration {d.id}: cost {d.cost} outside 2..5`)
end
local colorways = readJson("data-src/colorways.json")
local cheers = readJson("data-src/cheers.json")

-- ── Manifests ───────────────────────────────────────────────────────────────
local audioManifest = readJson("data-src/audio_manifest.json") :: { [string]: string }
local iconManifest = readJson("data-src/icon_manifest.json") :: { [string]: string }
for text in audioManifest do
	check(textSeen[text] == true, `audio manifest key {text} not in curriculum`)
end
for text in iconManifest do
	check(textSeen[text] == true, `icon manifest key {text} not in curriculum`)
end

-- ── Music (owner fills soundId after uploading assets/music/*.mp3) ──────────
type MusicTrack = {
	soundId: string,
	file: string,
	loop: boolean,
	volume: number,
	maxSeconds: number?,
}
local music =
	readJson("data-src/music_manifest.json") :: { note: string, tracks: { [string]: MusicTrack } }
for _, name in { "hub", "kiosk", "battle", "victory" } do
	check(music.tracks[name] ~= nil, `music manifest missing track "{name}"`)
end
for name, track in music.tracks do
	check(
		track.soundId == "" or string.find(track.soundId, "^rbxassetid://%d+$") ~= nil,
		`music track {name}: soundId must be "" or rbxassetid://<number>`
	)
	check(track.volume > 0 and track.volume <= 1, `music track {name}: volume outside (0, 1]`)
end

-- ── Conflicts (picture-confusable pairs, seeded from the web game) ──────────
local conflicts = readJson("data-src/raw/conflicts_web.json") :: { [string]: { string } }

-- ── Rigs (procedural build parameters; every animal needs one) ──────────────
local rigs = readJson("data-src/rigs.json") :: { note: string, rigs: { [string]: any } }
for _, a in animals do
	check(rigs.rigs[a.rig] ~= nil, `animal {a.char}: no rig params for "{a.rig}"`)
end

if #errors > 0 then
	print(`BUILD-DATA FAILED — {#errors} error(s):`)
	for _, e in errors do
		print(`  ✗ {e}`)
	end
	process.exit(1)
end

emit("Curriculum", curriculum)
emit("Animals", animals)
emit("Opponents", opponents)
emit("Words", words)
emit("Foods", foods)
emit("Decorations", decorations)
emit("Colorways", colorways)
emit("Cheers", cheers)
emit("AudioManifest", audioManifest)
emit("IconManifest", iconManifest)
emit("HomophoneIndex", pinyinIndex)
emit("Conflicts", conflicts)
emit("Rigs", rigs)
emit("StarterGhosts", readJson("data-src/starter_ghosts.json"))
emit("MusicManifest", music.tracks)

print(
	`OK: {#curriculum} items (700 curriculum in 14 bands x 50, {#curriculum - 700} bonus), {#animals} animals, {#opponents} rungs, {#words} words`
)
print(`emitted 13 modules into src/shared/Data/`)
