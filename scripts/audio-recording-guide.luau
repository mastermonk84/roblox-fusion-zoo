--!strict
-- Generates AUDIO_RECORDING_GUIDE.md: the owner's band-batched recording
-- sheet for the ~700 voice clips. Regenerate after any curriculum change:
--   lune run scripts/audio-recording-guide

local fs = require("@lune/fs")
local serde = require("@lune/serde")

type Item = {
	text: string,
	pinyin: string,
	english: string,
	band: number,
	seq: number,
	grammar: boolean,
	bonus: boolean?,
	source: string,
}

local items = serde.decode("json", fs.readFile("data-src/curriculum_grade1.json")) :: { Item }
local audio =
	serde.decode("json", fs.readFile("data-src/audio_manifest.json")) :: { [string]: string }

local lines: { string } = {}
local function push(line: string)
	table.insert(lines, line)
end

push("# AUDIO_RECORDING_GUIDE — voice clips for listen mode")
push("")
push(
	"**Generated by `lune run scripts/audio-recording-guide` — regenerate after curriculum edits.**"
)
push("")
push("Listen mode (the dominant quiz mode) exists only for characters with a clip. The engine")
push("degrades gracefully — uncovered characters are served through picture/pinyin modes — so")
push("record in band order and ship each batch as it lands: every batch immediately improves")
push("the youngest players' experience first.")
push("")
push("## How to record")
push("")
push("- One clip per character: say the character once, clearly, at a kid-friendly pace")
push('  ("**马**" — just the syllable, no sentence). Aim for ~1 second of speech.')
push("- Any quiet room + phone voice memo is fine; consistent distance from the mic matters")
push("  more than equipment. Keep one session per band so the tone stays uniform.")
push("- Export as MP3 or OGG (Roblox accepts both; under 20MB is automatic at this length).")
push("- Grammar words (的 了 着 …) need **no clip** — they are pinyin-mode only by design")
push("  and are excluded from the lists below.")
push("")
push("## Upload + wiring (per batch)")
push("")
push("1. Upload the batch at create.roblox.com → Creations → Audio.")
push('2. Paste each asset id into `data-src/audio_manifest.json`: `"马": "rbxassetid://123456"`.')
push("3. `lune run scripts/build-data` (validates every key) then commit — done. The kiosk")
push("   starts serving listen questions for those characters on the next place build.")
push("4. `lune run scripts/audio-manifest-check` shows coverage and what is still blocked.")
push("")

local totalNeeded = 0
local totalDone = 0
for band = 1, 14 do
	local batch: { Item } = {}
	local done = 0
	for _, item in items do
		if item.band == band and not item.grammar and not item.bonus then
			table.insert(batch, item)
			if audio[item.text] ~= nil and audio[item.text] ~= "" then
				done += 1
			end
		end
	end
	totalNeeded += #batch
	totalDone += done
	push(`## Band {band} — {#batch} clips ({done} recorded)`)
	push("")
	push("| # | 字 | pinyin | say it like | ✓ |")
	push("|---|---|---|---|---|")
	for _, item in batch do
		local mark = if audio[item.text] ~= nil and audio[item.text] ~= "" then "✅" else ""
		push(`| {item.seq} | {item.text} | {item.pinyin} | {item.english} | {mark} |`)
	end
	push("")
end

-- Bonus chars want clips too (they are quizzable), listed last: lowest priority.
local bonusBatch: { Item } = {}
for _, item in items do
	if item.bonus and not item.grammar then
		table.insert(bonusBatch, item)
	end
end
push(`## Bonus characters — {#bonusBatch} clips (record last)`)
push("")
push("| 字 | pinyin | say it like |")
push("|---|---|---|")
for _, item in bonusBatch do
	push(`| {item.text} | {item.pinyin} | {item.english} |`)
end
push("")
push(`**Progress: {totalDone} / {totalNeeded} curriculum clips recorded.**`)
push("")

fs.writeFile("AUDIO_RECORDING_GUIDE.md", table.concat(lines, "\n"))
print(
	`AUDIO_RECORDING_GUIDE.md: {totalNeeded} curriculum clips ({totalDone} recorded), {#bonusBatch} bonus`
)
